<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F7F7">

    <!-- ========================================================= -->
    <!-- TOP HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:background="#DFF5EE">

        <TextView
            android:id="@+id/tvRegistrationRequestsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Employee Registration Requests"
            android:textColor="#124C3D"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="sans" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Review, authorize, or decline employee account registration applications"
            android:textColor="#657985"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- MAIN WHITE CONTAINER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:paddingTop="14dp">

        <!-- ===================================================== -->
        <!-- TABS -->
        <!-- ===================================================== -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabPending"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Pending Approval (0)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="#084836" />

                <TextView
                    android:id="@+id/tabProcessed"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Processed (0)"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:background="#F7F9FC" />

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="All Requests (0)"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:background="#F7F9FC" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- ===================================================== -->
        <!-- DIVIDER -->
        <!-- ===================================================== -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#E9EEF2" />

        <!-- ===================================================== -->
        <!-- LOADING -->
        <!-- ===================================================== -->

        <ProgressBar
            android:id="@+id/progressRequests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <!-- ===================================================== -->
        <!-- EMPTY MESSAGE -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvNoRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="30dp"
            android:text="No pending registration requests."
            android:textColor="#64748B"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- ===================================================== -->
        <!-- TABLE SCROLL -->
        <!-- ===================================================== -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:fillViewport="false"
            android:scrollbars="horizontal">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/requestsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

        </HorizontalScrollView>

        <!-- ===================================================== -->
        <!-- REFRESH -->
        <!-- ===================================================== -->

        <Button
            android:id="@+id/btnRefreshRequests"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:text="Refresh"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>