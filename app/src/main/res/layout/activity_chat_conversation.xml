<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chat_bg"
    android:fitsSystemWindows="true">

    <!-- Chat Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_header"
        android:elevation="3dp">

        <ImageButton
            android:id="@+id/btnChatBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:padding="9dp" />

        <FrameLayout
            android:id="@+id/chatAvatarContainer"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_ring"
                android:padding="2dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgChatAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/orange_50"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:scaleType="centerCrop"
                    android:padding="0dp"
                    android:contentDescription="View contact profile"
                    app:shapeAppearanceOverlay="@style/CircleImage" />
            </FrameLayout>

            <View
                android:id="@+id/onlineDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/groupInfoHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvChatContactName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Employee"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvChatContactStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Offline"
                android:textColor="@color/orange_600"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnChatOptions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more"
            android:contentDescription="Chat options"
            android:scaleType="centerInside"
            android:padding="9dp" />
    </LinearLayout>

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />

    <!-- Reply Preview -->
    <LinearLayout
        android:id="@+id/replyPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:elevation="1dp"
        android:background="@drawable/bg_reply_preview"
        android:visibility="gone">

        <View
            android:layout_width="4dp"
            android:layout_height="44dp"
            android:background="@color/orange_500" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReplyPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Replying to message"
                android:textColor="@color/orange_700"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReplyPreviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCancelReply"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Cancel reply"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Message Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:background="@color/chat_bg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/bg_input"
            android:elevation="1dp">

            <ImageButton
                android:id="@+id/btnChatAttachment"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_add"
                android:contentDescription="Attach file"
                android:scaleType="centerInside"
                android:padding="9dp" />

            <EditText
                android:id="@+id/etChatMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Type a message"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textCursorDrawable="@null"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Voice Recording Button -->
        <ImageButton
            android:id="@+id/btnRecordVoice"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_icon_circle"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Hold to record voice message"
            android:scaleType="centerInside"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/btnSendChatMessage"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_send_btn"
            android:contentDescription="Send message"
            android:elevation="4dp"
            android:padding="12dp"
            android:src="@drawable/ic_send" />
    </LinearLayout>

</LinearLayout>
