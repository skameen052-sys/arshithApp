<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
    <TextView android:id="@+id/txtTeamAvatar" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_teams_avatar" android:gravity="center" android:text="T" android:textColor="@android:color/white" android:textSize="17sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/txtTeamName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Development Team" android:textColor="@color/teams_text" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/txtLastMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Last message..." android:textColor="@color/teams_secondary_text" android:textSize="12sp"/>
        <TextView android:id="@+id/txtTeamMembers" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Team conversation" android:textColor="@color/teams_secondary_text" android:textSize="10sp"/>
    </LinearLayout>
    <TextView android:id="@+id/txtUnreadCount" android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/bg_unread_badge" android:gravity="center" android:text="2" android:textColor="@android:color/white" android:textSize="10sp" android:visibility="gone"/>
</LinearLayout>