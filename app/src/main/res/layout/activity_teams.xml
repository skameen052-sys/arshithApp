<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/teamsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8F5">

    <!-- CONVERSATION LIST -->
    <LinearLayout
        android:id="@+id/layoutChatList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- TITLE AND NEW GROUP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat"
                    android:textColor="#183D2B"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Connect and collaborate with your team"
                    android:textColor="#75877B"
                    android:textSize="13sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewGroup"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="+ New Group"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:backgroundTint="#218C52"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- SEARCH -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            app:boxBackgroundColor="#EAF3EC"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="13dp"
            app:boxCornerRadiusBottomStart="13dp"
            app:boxCornerRadiusTopEnd="13dp"
            app:boxCornerRadiusTopStart="13dp"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="#218C52">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtSearchTeams"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Search chats..."
                android:singleLine="true"
                android:textColor="#183D2B"
                android:textColorHint="#87998C"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- CHAT FILTERS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_filter_selected"
                    android:backgroundTint="#218C52"
                    android:minWidth="75dp"
                    android:text="All"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnFilterDirect"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_filter_unselected"
                    android:backgroundTint="#E5F0E7"
                    android:minWidth="85dp"
                    android:text="Direct"
                    android:textAllCaps="false"
                    android:textColor="#218C52" />

                <Button
                    android:id="@+id/btnFilterTeams"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_filter_unselected"
                    android:backgroundTint="#E5F0E7"
                    android:minWidth="85dp"
                    android:text="Groups"
                    android:textAllCaps="false"
                    android:textColor="#218C52" />

                <Button
                    android:id="@+id/btnFilterUnread"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_filter_unselected"
                    android:backgroundTint="#E5F0E7"
                    android:minWidth="85dp"
                    android:text="Unread"
                    android:textAllCaps="false"
                    android:textColor="#218C52" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- CONVERSATION RECYCLER -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerConversations"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </LinearLayout>

    <!-- FULL SCREEN CONVERSATION -->
    <LinearLayout
        android:id="@+id/layoutConversation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F4F8F5"
        android:visibility="gone">

        <!-- CHAT HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <ImageButton
                android:id="@+id/btnBackToChats"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#218C52" />

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Chat profile"
                android:src="@drawable/ic_profile"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtChatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Employee"
                    android:textColor="#183D2B"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtChatSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Offline"
                    android:textColor="#75877B"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnChatSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search messages"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#218C52" />

            <ImageButton
                android:id="@+id/btnChatMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:src="@android:drawable/ic_menu_more"
                app:tint="#218C52" />

        </LinearLayout>

        <!-- MESSAGE LIST -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="12dp"
                android:overScrollMode="ifContentScrolls" />

            <TextView
                android:id="@+id/txtEmptyMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="No messages yet. Start the conversation."
                android:textColor="#75877B"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- QUICK REPLIES -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtQuickReply1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chat_quick_reply"
                    android:padding="10dp"
                    android:text="Working on it right away! 👍"
                    android:textColor="#218C52"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtQuickReply2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chat_quick_reply"
                    android:padding="10dp"
                    android:text="Please check the latest updates."
                    android:textColor="#218C52"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtQuickReply3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_quick_reply"
                    android:padding="10dp"
                    android:text="Approved, please proceed."
                    android:textColor="#218C52"
                    android:textSize="13sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- MESSAGE COMPOSER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- REPLY PREVIEW -->
            <LinearLayout
                android:id="@+id/layoutReplyComposer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#EAF3EC"
                android:padding="9dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtReplyComposerSender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#218C52"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtReplyComposerContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#43564A"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnCancelReply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Cancel reply"
                    android:textColor="#218C52"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- AUDIO RECORDING PANEL: SINGLE DECLARATION -->
            <LinearLayout
                android:id="@+id/layoutRecording"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:background="#EAF3EC"
                android:visibility="gone">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_recording_dot" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:text="Recording voice message..."
                    android:textColor="#183D2B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRecordingDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="00:00"
                    android:textColor="#218C52"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCancelRecording"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cancel recording"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#C0392B" />

                <ImageButton
                    android:id="@+id/btnStopRecording"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_chat_send"
                    android:backgroundTint="#218C52"
                    android:contentDescription="Stop and send recording"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="#FFFFFF" />

            </LinearLayout>

            <!-- MESSAGE INPUT ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnAttachFile"
                    android:layout_width="40dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Attach file"
                    android:src="@android:drawable/ic_menu_add"
                    app:tint="#218C52" />

                <EditText
                    android:id="@+id/edtMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_message_input"
                    android:hint="Message..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="44dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="#183D2B"
                    android:textColorHint="#87998C"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnRecordAudio"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Record voice message"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:tint="#2E7D32" />

                <ImageButton
                    android:id="@+id/btnSendMessage"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_chat_send"
                    android:backgroundTint="#218C52"
                    android:contentDescription="Send message"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
