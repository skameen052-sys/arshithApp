<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F4">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- SCROLLABLE DASHBOARD -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="22dp">

                <!-- HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingTop="26dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="20dp">

                    <ImageButton
                        android:id="@+id/btnMenu"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/dashboard_circle_button"
                        android:contentDescription="Open navigation menu"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        android:tint="#0F4D36" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome back"
                            android:textColor="#64756D"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvWelcome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Employee"
                            android:textColor="#102820"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Employee"
                            android:textColor="#64756D"
                            android:textSize="12sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgArshithLogo"
                        android:layout_width="92dp"
                        android:layout_height="54dp"
                        android:contentDescription="Arshith Connect logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/arshith_connect_logo" />

                </LinearLayout>

                <!-- ATTENDANCE CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/dashboard_attendance_card"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- DATE AND STATUS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCurrentDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Loading date..."
                            android:textColor="#B7E0CF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTodayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/dashboard_status_pill"
                            android:paddingStart="12dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="7dp"
                            android:text="Not Checked In"
                            android:textColor="#B7F7D9"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- CURRENT TIME -->
                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:autoSizeMaxTextSize="38sp"
                        android:autoSizeMinTextSize="24sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:text="--:--:--"
                        android:textColor="#FFFFFF"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <!-- WORK MODE -->
                    <TextView
                        android:id="@+id/tvWorkMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Choose WFO or WFH during check-in"
                        android:textColor="#B7E0CF"
                        android:textSize="15sp" />

                    <!-- ATTENDANCE STATISTICS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- CHECK IN -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/dashboard_stat_tile"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check-in"
                                android:textColor="#B7E0CF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvCheckIn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:autoSizeMaxTextSize="16sp"
                                android:autoSizeMinTextSize="11sp"
                                android:autoSizeTextType="uniform"
                                android:maxLines="1"
                                android:text="--:--"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- CHECK OUT -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/dashboard_stat_tile"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check-out"
                                android:textColor="#B7E0CF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvCheckOut"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:autoSizeMaxTextSize="16sp"
                                android:autoSizeMinTextSize="11sp"
                                android:autoSizeTextType="uniform"
                                android:maxLines="1"
                                android:text="--:--"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- WORKED DURATION -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/dashboard_stat_tile"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Worked"
                                android:textColor="#B7E0CF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvWorkingDuration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:autoSizeMaxTextSize="16sp"
                                android:autoSizeMinTextSize="11sp"
                                android:autoSizeTextType="uniform"
                                android:maxLines="2"
                                android:text="0h 00m"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- CHECK IN BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckIn"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="22dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="✓ Check In"
                        android:textAllCaps="false"
                        android:textColor="#0F4D36"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        app:cornerRadius="24dp" />

                    <!-- CHECK OUT BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckOut"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="22dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="⇥ Check Out"
                        android:textAllCaps="false"
                        android:textColor="#0F4D36"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:cornerRadius="24dp" />

                    <!-- ATTENDANCE MESSAGE -->
                    <TextView
                        android:id="@+id/tvAttendanceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="Please check in to record your attendance."
                        android:textColor="#B7E0CF"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- QUICK ACTIONS HEADING -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="26dp"
                    android:layout_marginEnd="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quick actions"
                        android:textColor="#102820"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Everything in one place"
                        android:textColor="#64756D"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- QUICK ACTIONS ROW 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="18dp"
                    android:orientation="horizontal">

                    <!-- ANNOUNCEMENTS -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="#FFF0D8"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardUseCompatPadding="false"
                        app:strokeColor="#FFF0D8"
                        app:strokeWidth="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1">

                                    <TextView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_gravity="top|start"
                                        android:gravity="center"
                                        android:text="›"
                                        android:textColor="#102820"
                                        android:textSize="30sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:layout_width="72dp"
                                        android:layout_height="72dp"
                                        android:layout_gravity="end|center_vertical"
                                        android:contentDescription="Announcements illustration"
                                        android:scaleType="fitCenter"
                                        android:src="@drawable/quick_announcements" />

                                </FrameLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Announcements"
                                    android:textColor="#102820"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Company updates"
                                    android:textColor="#64756D"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <!-- TRANSPARENT CLICK TARGET -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAnnouncements"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:backgroundTint="@android:color/transparent"
                                android:contentDescription="Announcements"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:elevation="0dp"
                                android:stateListAnimator="@null"
                                android:text=""
                                android:textColor="@android:color/transparent"
                                app:backgroundTint="@android:color/transparent"
                                app:cornerRadius="24dp"
                                app:rippleColor="@android:color/transparent"
                                app:strokeWidth="0dp" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- MEETINGS -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="#E5EDFF"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardUseCompatPadding="false"
                        app:strokeColor="#E5EDFF"
                        app:strokeWidth="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1">

                                    <TextView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_gravity="top|start"
                                        android:gravity="center"
                                        android:text="›"
                                        android:textColor="#102820"
                                        android:textSize="30sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:layout_width="72dp"
                                        android:layout_height="72dp"
                                        android:layout_gravity="end|center_vertical"
                                        android:contentDescription="Meetings illustration"
                                        android:scaleType="fitCenter"
                                        android:src="@drawable/quick_meetings" />

                                </FrameLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:text="Meetings"
                                    android:textColor="#102820"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:maxLines="1"
                                    android:text="Schedule &amp; join"
                                    android:textColor="#64756D"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <!-- TRANSPARENT CLICK TARGET -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMeetings"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:backgroundTint="@android:color/transparent"
                                android:contentDescription="Meetings"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:elevation="0dp"
                                android:stateListAnimator="@null"
                                android:text=""
                                android:textColor="@android:color/transparent"
                                app:backgroundTint="@android:color/transparent"
                                app:cornerRadius="24dp"
                                app:rippleColor="@android:color/transparent"
                                app:strokeWidth="0dp" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- QUICK ACTIONS ROW 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="18dp"
                    android:orientation="horizontal">

                    <!-- WORK ASSIGNMENTS -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="#DDF5E9"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardUseCompatPadding="false"
                        app:strokeColor="#DDF5E9"
                        app:strokeWidth="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1">

                                    <TextView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_gravity="top|start"
                                        android:gravity="center"
                                        android:text="›"
                                        android:textColor="#102820"
                                        android:textSize="30sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:layout_width="72dp"
                                        android:layout_height="72dp"
                                        android:layout_gravity="end|center_vertical"
                                        android:contentDescription="Work assignments illustration"
                                        android:scaleType="fitCenter"
                                        android:src="@drawable/quick_work" />

                                </FrameLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Work Assignments"
                                    android:textColor="#102820"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:maxLines="1"
                                    android:text="Tasks &amp; updates"
                                    android:textColor="#64756D"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <!-- TRANSPARENT CLICK TARGET -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnWorkAssignments"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:backgroundTint="@android:color/transparent"
                                android:contentDescription="Work assignments"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:elevation="0dp"
                                android:stateListAnimator="@null"
                                android:text=""
                                android:textColor="@android:color/transparent"
                                app:backgroundTint="@android:color/transparent"
                                app:cornerRadius="24dp"
                                app:rippleColor="@android:color/transparent"
                                app:strokeWidth="0dp" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- LEAVE -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="#EEE3FF"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardUseCompatPadding="false"
                        app:strokeColor="#EEE3FF"
                        app:strokeWidth="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1">

                                    <TextView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_gravity="top|start"
                                        android:gravity="center"
                                        android:text="›"
                                        android:textColor="#102820"
                                        android:textSize="30sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:layout_width="72dp"
                                        android:layout_height="72dp"
                                        android:layout_gravity="end|center_vertical"
                                        android:contentDescription="Leave illustration"
                                        android:scaleType="fitCenter"
                                        android:src="@drawable/quick_leave" />

                                </FrameLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:text="Leave"
                                    android:textColor="#102820"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:maxLines="1"
                                    android:text="Apply &amp; track"
                                    android:textColor="#64756D"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <!-- TRANSPARENT CLICK TARGET -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLeave"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:backgroundTint="@android:color/transparent"
                                android:contentDescription="Leave"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:elevation="0dp"
                                android:stateListAnimator="@null"
                                android:text=""
                                android:textColor="@android:color/transparent"
                                app:backgroundTint="@android:color/transparent"
                                app:cornerRadius="24dp"
                                app:rippleColor="@android:color/transparent"
                                app:strokeWidth="0dp" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- HIDDEN COMPATIBILITY VIEWS -->
                <Button
                    android:id="@+id/btnWFO"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnWFH"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvWorkingDays"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPresentDays"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAbsentDays"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAttendancePercentage"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/attendanceProgress"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnHistory"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

            </LinearLayout>

        </ScrollView>

        <!-- BOTTOM NAVIGATION -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="76dp"
