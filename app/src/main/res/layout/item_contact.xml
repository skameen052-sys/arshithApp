<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/txtContactAvatar" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_teams_avatar" android:gravity="center" android:text="A" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/txtContactName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Employee Name" android:textColor="#24213B" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/txtContactSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Designation • Department • Employee" android:textColor="#718096" android:textSize="12sp"/>
        <TextView android:id="@+id/txtContactEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="employee@example.com" android:textColor="#9290A0" android:textSize="11sp"/>
    </LinearLayout>
    <CheckBox android:id="@+id/chkContact" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="#8138E8" android:visibility="gone"/>
</LinearLayout>