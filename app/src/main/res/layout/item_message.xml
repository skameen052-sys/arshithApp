<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/messageBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_message_incoming">

        <TextView
            android:id="@+id/txtMessageSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sender"
            android:textColor="#607D8B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutReplyPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#18000000"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtReplySender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reply sender"
                android:textColor="#455A64"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtReplyContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reply content"
                android:textColor="#455A64"
                android:textSize="13sp"
                android:maxLines="2" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message"
            android:textColor="#202124"
            android:textSize="15sp"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/txtAttachmentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attachment"
            android:textColor="#1565C0"
            android:textSize="13sp"
            android:visibility="gone"
            android:paddingTop="6dp" />

        <!-- Audio message player -->
        <LinearLayout
            android:id="@+id/layoutAudioPlayer"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnAudioPlay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_play"
                    android:contentDescription="Play audio"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:tint="#1565C0" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:id="@+id/txtAudioFileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Voice message"
                        android:textColor="#202124"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <SeekBar
                        android:id="@+id/seekAudioProgress"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#1565C0"
                        android:thumbTint="#1565C0" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/txtAudioCurrentTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0:00"
                            android:textColor="#808080"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/txtAudioDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="#808080"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/txtMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 AM"
                android:textColor="#808080"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtMessageStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#607D8B"
                android:textSize="12sp"
                android:paddingStart="5dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
