<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FC"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="130dp"
        android:paddingBottom="22dp">

        <!-- ARSHITH CONNECT LOGO -->

        <ImageView
            android:id="@+id/imgArshithLogo"
            android:layout_width="170dp"
            android:layout_height="76dp"
            android:adjustViewBounds="true"
            android:contentDescription="Arshith Connect Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/arshith_connect_logo1" />

        <!-- PORTAL TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="Employee Attendance Portal"
            android:textColor="#536074"
            android:textSize="15sp" />

        <!-- LOGIN CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/login_card_background"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="20dp">

            <!-- WELCOME + ADMIN -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Welcome Back"
                    android:textColor="#104735"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/tvAdminEntry"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_admin_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="100dp"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="Admin shield"
                        android:src="@drawable/ic_admin_shield"
                        android:tint="#7046D2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Admin"
                        android:textColor="#4F5D73"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- SUBTITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Sign in to manage your attendance"
                android:textColor="#71809A"
                android:textSize="14sp" />

            <!-- EMAIL LABEL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Email"
                android:textColor="#243047"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- EMAIL FIELD -->

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_login_input"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#172033"
                android:textColorHint="#8490A4"
                android:textSize="15sp" />

            <!-- PASSWORD LABEL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Password"
                android:textColor="#243047"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- PASSWORD FIELD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_login_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="9dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Enter your password"
                    android:inputType="textPassword"
                    android:paddingStart="0dp"
                    android:paddingEnd="5dp"
                    android:singleLine="true"
                    android:textColor="#172033"
                    android:textColorHint="#8490A4"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Show or hide password"
                    android:padding="8dp"
                    android:src="@drawable/ic_visibility_off"
                    android:tint="#64748B" />

            </LinearLayout>

            <!-- LOGIN BUTTON -->

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_login_button"
                android:elevation="2dp"
                android:text="LOGIN"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- REGISTER BUTTON -->

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_register_button"
                android:text="REGISTER"
                android:textAllCaps="false"
                android:textColor="#7046D2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- PROGRESS BAR -->

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- FOOTER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Arshith Connect • Employee Portal"
            android:textColor="#71809A"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>