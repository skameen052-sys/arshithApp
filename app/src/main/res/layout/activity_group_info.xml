<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#075E54"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnGroupInfoBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Group Info"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Group Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/imgGroupPhoto"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="#075E54"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_myplaces"
                android:contentDescription="Group photo" />

            <TextView
                android:id="@+id/tvGroupInfoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Group Name"
                android:textColor="#202124"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGroupMemberCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="0 members"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGroupCreator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Created by"
                android:textColor="#075E54"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnEditGroupDetails"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginTop="14dp"
                android:text="Edit Group Details"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#075E54" />
        </LinearLayout>

        <!-- Group Management -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:padding="16dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GROUP MANAGEMENT"
                android:textColor="#075E54"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnAddGroupMembers"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Add Members"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#075E54" />

            <Button
                android:id="@+id/btnTransferOwnership"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Transfer Ownership"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#3975A8"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLeaveGroup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Leave Group"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#B3261E" />
        </LinearLayout>

        <!-- Members Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp"
            android:text="GROUP MEMBERS"
            android:textColor="#075E54"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Members List -->
        <LinearLayout
            android:id="@+id/layoutGroupMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF" />

    </LinearLayout>
</ScrollView>
