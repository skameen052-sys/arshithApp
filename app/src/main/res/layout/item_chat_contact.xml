<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/imgContactPhoto"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_profile_placeholder"
        android:contentDescription="Employee profile picture" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/tvContactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Employee Name"
            android:textColor="#172B4D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvContactAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:maxLines="1" />

    </LinearLayout>

    <CheckBox
        android:id="@+id/cbSelectContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:contentDescription="Select employee" />

    <ImageView
        android:id="@+id/imgOpenChat"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/ic_media_next"
        android:contentDescription="Open chat"
        android:tint="#94A3B8" />

</LinearLayout>